VITE_API_BASE=/api
# Куда dev-сервер Vite проксирует /api (переменная окружения процесса или .env.local):
#   VITE_DEV_API_TARGET=http://localhost:8000 npm run dev
# Только для тестового стенда, значение совпадает с DEMO_PASSWORD в корневом .env.
