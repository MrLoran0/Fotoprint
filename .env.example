# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Безопасность ---
# Любая длинная случайная строка. Пусто — сгенерируется при старте (токены сбросятся после перезапуска).
JWT_SECRET=
# Пароль для всех тестовых учётных записей из data/users.json
DEMO_PASSWORD=fokus-demo

# --- LLM ---
# gemini — внешний API (демо по умолчанию: умная локальная модель не помещается на наши ноутбуки)
# openai — внешний API OpenAI (GPT); anthropic — внешний API Anthropic (Claude)
# local  — любой OpenAI-совместимый сервер в контуре компании (vLLM/TGI/LM Studio) — путь для пилота
# ollama — локальная модель через Ollama (ноутбук с GPU)
# fake   — dev-заглушка без ИИ: разработка интерфейса и данных без GPU и ключа. На стенде и в демо НЕЛЬЗЯ
LLM_PROVIDER=gemini

# Локальная модель в контуре (LLM_PROVIDER=local), например vLLM: http://gpu-server:8001/v1
LOCAL_BASE_URL=http://host.docker.internal:8001/v1
LOCAL_API_KEY=
LOCAL_MODEL=

# Ollama (LLM_PROVIDER=ollama)
LLM_MODEL=qwen3:8b
EMBED_MODEL=bge-m3
# Ollama в этом же compose (профиль gpu): http://ollama:11434
# Ollama на хосте:                         http://host.docker.internal:11434
# Ollama на ноутбуке с RTX 4060 по сети:   http://192.168.x.x:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_NUM_CTX=8192

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI (LLM_PROVIDER=openai): модель должна быть доступна вашему ключу
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Распознавание аудио (независимо от LLM_PROVIDER) ---
# off — выключено; whisper — в контуре; openai / gemini — внешние API с ключами выше.
STT_PROVIDER=off
STT_MAX_MB=200
STT_TIMEOUT_S=240
STT_WHISPER_MODEL_DIR=/models/whisper
STT_WHISPER_DEVICE=cpu
STT_WHISPER_COMPUTE_TYPE=int8
STT_OPENAI_MODEL=gpt-transcribe
STT_GEMINI_MODEL=gemini-2.5-flash
INSTALL_WHISPER=false
# Для Docker-установки faster-whisper и подключения весов см. docs/deployment.md.

# --- Сценарий ---
# Часовой пояс компании и «время сценария» для повторяемого демо (пусто — реальное время)
COMPANY_TZ=Europe/Minsk
SCENARIO_NOW=

# --- Порты на хосте ---
WEB_PORT=8080
API_PORT=8000
MAILPIT_UI_PORT=8025
DB_PORT=5433
